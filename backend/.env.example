# Local configuration template. Replace placeholders in your untracked .env.
# This file must never contain real passwords, tokens, or connection strings.
PORT=3000
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/gymmatch
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
REDIS_URL=redis://localhost:6379

# Optional, only for the manual socketTest.js listener. Use a current login JWT
# in your ignored .env; never commit the token. The application does not use it.
SOCKET_TEST_TOKEN=
